# ═══════════════════════════════════════════
# Success Center — Production environment
# انسخ الملف: cp .env.production.example .env
# ═══════════════════════════════════════════

# —— Domain / public URLs (غيّر لدومينك) ——
# مثال: https://app.success-center.com  و  https://api.success-center.com
NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN.com/api
NEXT_PUBLIC_CHECKIN_API_URL=https://api.YOUR_DOMAIN.com/api/check-in
WEB_PORT=3000
API_PORT=3001

# —— Auth ——
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CENTER_NAME=Success

# —— Database (اختَر واحد من الخيارين) ——

# خيار A — Postgres داخل Docker على نفس السيرفر (الافتراضي)
POSTGRES_USER=center
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=center_erp
# افتح البورت لو عايز توصل من جهازك / Prisma Studio / DBeaver
# مثال لينك من برّه السيرفر:
# postgresql://center:PASSWORD@YOUR_SERVER_IP:5432/center_erp?schema=public
POSTGRES_PORT=5432

# لينك الـ API جوّه Docker (بين الحاويات) — اتساب لو بتستخدم Postgres المحلي
DATABASE_URL=postgresql://center:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/center_erp?schema=public

# خيار B — DB خارجية (Neon / Supabase / Railway Postgres)
# علّق سطر DATABASE_URL فوق وحط لينك المزود هنا بدلًا منه، مثال Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# —— Redis ——
REDIS_URL=redis://redis:6379

# —— Device check-in kiosk ——
DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY
NEXT_PUBLIC_DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY

# —— Messaging (اختياري) ——
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
OVERDUE_REMINDERS_ENABLED=true
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
