DATABASE_URL=postgresql://center:center_secret@localhost:5433/center_erp?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
API_PORT=3001
WEB_PORT=3000
CENTER_NAME=Success
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Messaging
SMS_PROVIDER=console
# console | meta | twilio
WHATSAPP_PROVIDER=console
OVERDUE_REMINDERS_ENABLED=true

# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved template instead of free-text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# Twilio WhatsApp (when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Device check-in
DEVICE_API_KEY=success-device-key-change-me
NEXT_PUBLIC_DEVICE_API_KEY=success-device-key-change-me
NEXT_PUBLIC_CHECKIN_API_URL=http://localhost:3001/api/check-in
# DEFAULT_CHECKIN_GROUP_ID=

# Production compose DB
POSTGRES_USER=center
POSTGRES_PASSWORD=center_secret
POSTGRES_DB=center_erp
POSTGRES_PORT=5432

# Production: use @postgres host inside Docker network
# DATABASE_URL=postgresql://center:center_secret@postgres:5432/center_erp?schema=public
# External tools from your PC (after publish): postgresql://center:center_secret@SERVER_IP:5432/center_erp?schema=public
# Or managed Neon/Supabase connection string with ?sslmode=require
