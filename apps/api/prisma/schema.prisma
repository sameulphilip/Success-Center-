generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  CENTER_MANAGER
  ACCOUNTANT
  RECEPTION
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSource {
  MANUAL
  QR_STUDENT
  QR_GATE
  NFC_CARD
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum MessageChannel {
  IN_APP
  SMS
  WHATSAPP
}

enum MessageJobStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutStatus {
  PENDING
  PARTIAL
  PAID
}

enum BookingStatus {
  SUBMITTED
  PAID
  CANCELLED
}

enum ClassSessionStatus {
  OPEN
  CLOSED
}

enum SessionPayMethod {
  CASH
  VODAFONE_CASH
}

enum SessionPayStatus {
  PENDING_CONFIRM
  CONFIRMED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundReason {
  EXPULSION
  LATE
  CANCELLED
  OTHER
}

enum BlockScope {
  CENTER
  TEACHER
}

enum OpsCheckInSource {
  QR
  NFC
  PHONE
  MANUAL
}

enum OnlineCodeStatus {
  AVAILABLE
  SOLD
  REVOKED
}

enum RentalStatus {
  BOOKED
  PAID
  CANCELLED
  COMPLETED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  phone           String?   @unique
  mustSetPassword Boolean   @default(false)
  isActive        Boolean   @default(true)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  teacher         Teacher?
  parent          Parent?
  student         Student?
  refreshToken    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  auditLogs       AuditLog[]
  notifications   Notification[] @relation("UserNotifications")
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  nameAr      String
  nameEn      String
  permissions String[]
  users       User[]
}

model GradeLevel {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String
  sortOrder Int       @default(0)
  students  Student[]
  groups    Group[]
  teachers  TeacherGradeLevel[]
}

model Subject {
  id        String           @id @default(cuid())
  nameAr    String
  nameEn    String
  teachers  TeacherSubject[]
  groups    Group[]
  exams     Exam[]
  classSessions ClassSession[]
  onlineOffers  OnlineOffer[]
}

model Classroom {
  id       String          @id @default(cuid())
  name     String
  capacity Int             @default(30)
  groups   Group[]
  slots    ScheduleSlot[]
  rentals  RoomRental[]
}

model Parent {
  id        String          @id @default(cuid())
  userId    String?         @unique
  user      User?           @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String
  email     String?
  students  StudentParent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Student {
  id                String              @id @default(cuid())
  userId            String?             @unique
  user              User?               @relation(fields: [userId], references: [id])
  studentUid        String              @unique @default(cuid())
  firstName         String
  lastName          String
  phone             String?
  email             String?
  notes             String?
  gradeLevelId      String?
  gradeLevel        GradeLevel?         @relation(fields: [gradeLevelId], references: [id])
  isActive          Boolean             @default(true)
  phoneCheckInUsed  Int                 @default(0)
  parents           StudentParent[]
  enrollments       Enrollment[]
  attendance        AttendanceRecord[]
  grades            Grade[]
  invoices          Invoice[]
  payments          Payment[]
  sessionEntries    SessionEntry[]
  blocks            StudentBlock[]
  onlineCodeSales   OnlineCodeSale[]
  handoutSales      HandoutSale[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model StudentParent {
  studentId String
  parentId  String
  relation  String  @default("guardian")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

model Teacher {
  id          String           @id @default(cuid())
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  phone       String?
  email       String?
  hourlyRate  Decimal          @default(0) @db.Decimal(12, 2)
  isActive    Boolean          @default(true)
  subjects    TeacherSubject[]
  gradeLevels TeacherGradeLevel[]
  groups      Group[]
  attendance  AttendanceRecord[]
  payouts     TeacherPayout[]
  classSessions ClassSession[]
  studentBlocks StudentBlock[]
  onlineOffers  OnlineOffer[]
  handoutProducts HandoutProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model TeacherGradeLevel {
  teacherId    String
  gradeLevelId String
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@id([teacherId, gradeLevelId])
}

model Group {
  id           String          @id @default(cuid())
  name         String
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  gradeLevelId String
  gradeLevel   GradeLevel      @relation(fields: [gradeLevelId], references: [id])
  teacherId    String
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  classroomId  String?
  classroom    Classroom?      @relation(fields: [classroomId], references: [id])
  feeAmount    Decimal         @db.Decimal(12, 2)
  capacity     Int             @default(30)
  isActive     Boolean         @default(true)
  scheduleSlots ScheduleSlot[]
  enrollments  Enrollment[]
  sessions     AttendanceSession[]
  exams        Exam[]
  invoices     Invoice[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ScheduleSlot {
  id          String     @id @default(cuid())
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  dayOfWeek   Int
  startTime   String
  endTime     String

  @@index([dayOfWeek, startTime, endTime])
  @@index([classroomId, dayOfWeek])
}

model Enrollment {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  invoices  Invoice[]

  @@unique([studentId, groupId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  groupId     String
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessionDate DateTime           @db.Date
  startTime   String?
  endTime     String?
  notes       String?
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())

  @@unique([groupId, sessionDate])
}

model AttendanceRecord {
  id         String             @id @default(cuid())
  sessionId  String
  session    AttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student?           @relation(fields: [studentId], references: [id])
  teacherId  String?
  teacher    Teacher?           @relation(fields: [teacherId], references: [id])
  status     AttendanceStatus
  source     AttendanceSource   @default(MANUAL)
  markedAt   DateTime           @default(now())
  note       String?

  @@index([sessionId])
  @@index([studentId])
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  groupId      String?
  group        Group?        @relation(fields: [groupId], references: [id])
  feeAmount    Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  extras       Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  status       PaymentStatus @default(PENDING)
  note         String?
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  method        String   @default("CASH")
  receiptNumber String   @unique
  note          String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())
}

model TeacherPayout {
  id            String       @id @default(cuid())
  teacherId     String
  teacher       Teacher      @relation(fields: [teacherId], references: [id])
  periodStart   DateTime     @db.Date
  periodEnd     DateTime     @db.Date
  sessionsCount Int
  rate          Decimal      @db.Decimal(12, 2)
  grossAmount   Decimal      @db.Decimal(12, 2)
  deductions    Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal      @default(0) @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  maxScore  Decimal  @db.Decimal(8, 2)
  examDate  DateTime @db.Date
  grades    Grade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String  @id @default(cuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  score     Decimal @db.Decimal(8, 2)
  note      String?

  @@unique([examId, studentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  body      String
  isRead    Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())
}

model MessageTemplate {
  id        String         @id @default(cuid())
  code      String         @unique
  channel   MessageChannel
  titleAr   String?
  bodyAr    String
  titleEn   String?
  bodyEn    String?
  createdAt DateTime       @default(now())
}

model MessageJob {
  id         String           @id @default(cuid())
  channel    MessageChannel
  toPhone    String?
  toUserId   String?
  title      String?
  body       String
  status     MessageJobStatus @default(PENDING)
  error      String?
  meta       Json?
  createdAt  DateTime         @default(now())
  sentAt     DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

/// Digital booking form (replaces paper registration sheets)
model BookingForm {
  id           String              @id @default(cuid())
  slug         String              @unique
  title        String
  subtitle     String?
  academicYear String
  gradeLabel   String
  isPublished  Boolean             @default(false)
  defaultFee   Decimal             @default(0) @db.Decimal(12, 2)
  notes        String?
  offerings    BookingOffering[]
  submissions  BookingSubmission[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model BookingOffering {
  id          String             @id @default(cuid())
  formId      String
  form        BookingForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  teacherName String
  subjectName String
  isOnline    Boolean            @default(false)
  feeAmount   Decimal            @default(0) @db.Decimal(12, 2)
  pageNumber  Int                @default(1)
  sortOrder   Int                @default(0)
  teacherId   String?
  subjectId   String?
  isActive    Boolean            @default(true)
  selections  BookingSelection[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([formId, subjectName])
}

model BookingSubmission {
  id            String             @id @default(cuid())
  formId        String
  form          BookingForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  studentName   String
  studentPhone  String
  parentPhone   String
  status        BookingStatus      @default(SUBMITTED)
  totalAmount   Decimal            @default(0) @db.Decimal(12, 2)
  receiptNumber String?            @unique
  paidAt        DateTime?
  studentId     String?
  notes         String?
  selections    BookingSelection[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([formId, status])
  @@index([studentPhone])
}

model BookingSelection {
  id           String            @id @default(cuid())
  submissionId String
  submission   BookingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  offeringId   String
  offering     BookingOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  feeAmount    Decimal           @db.Decimal(12, 2)

  @@unique([submissionId, offeringId])
}

/// Pay-per-session operations (flexible walk-in classes)
model ClassSession {
  id                   String             @id @default(cuid())
  teacherId            String
  teacher              Teacher            @relation(fields: [teacherId], references: [id])
  subjectId            String?
  subject              Subject?           @relation(fields: [subjectId], references: [id])
  title                String?
  sessionDate          DateTime           @db.Date
  status               ClassSessionStatus @default(OPEN)
  feeAmount            Decimal            @db.Decimal(12, 2)
  teacherPercent       Decimal            @db.Decimal(5, 2)
  settledTeacherAmount Decimal?           @db.Decimal(12, 2)
  settledCenterAmount  Decimal?           @db.Decimal(12, 2)
  openedByUserId       String?
  closedByUserId       String?
  closedAt             DateTime?
  notes                String?
  entries              SessionEntry[]
  refunds              SessionRefund[]
  handoutSales         HandoutSale[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, sessionDate])
  @@index([teacherId, sessionDate])
}

model SessionEntry {
  id                 String           @id @default(cuid())
  sessionId          String
  session            ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  amount             Decimal          @db.Decimal(12, 2)
  method             SessionPayMethod
  payStatus          SessionPayStatus @default(PENDING_CONFIRM)
  vodafoneTxn        String?
  receiptNumber      String           @unique
  confirmedAt        DateTime?
  confirmedByUserId  String?
  checkedInAt        DateTime?
  checkInSource      OpsCheckInSource?
  refundedAmount     Decimal          @default(0) @db.Decimal(12, 2)
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  refunds            SessionRefund[]

  @@unique([sessionId, studentId])
  @@index([studentId, payStatus])
}

model SessionRefund {
  id              String       @id @default(cuid())
  sessionId       String
  session         ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entryId         String
  entry           SessionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  amount          Decimal      @db.Decimal(12, 2)
  reason          RefundReason
  note            String?
  isException     Boolean      @default(false)
  createdByUserId String?
  createdAt       DateTime     @default(now())

  @@index([sessionId])
}

model StudentBlock {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scope           BlockScope
  teacherId       String?
  teacher         Teacher?   @relation(fields: [teacherId], references: [id])
  reason          String
  isActive        Boolean    @default(true)
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([studentId, isActive])
}

/// Online subscription sold as a one-time code (center collects, splits with teacher)
model OnlineOffer {
  id             String            @id @default(cuid())
  teacherId      String
  teacher        Teacher           @relation(fields: [teacherId], references: [id])
  subjectId      String?
  subject        Subject?          @relation(fields: [subjectId], references: [id])
  title          String
  price          Decimal           @db.Decimal(12, 2)
  teacherPercent Decimal           @db.Decimal(5, 2)
  isActive       Boolean           @default(true)
  notes          String?
  codes          OnlineAccessCode[]
  sales          OnlineCodeSale[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model OnlineAccessCode {
  id        String           @id @default(cuid())
  offerId   String
  offer     OnlineOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  code      String           @unique
  status    OnlineCodeStatus @default(AVAILABLE)
  sale      OnlineCodeSale?
  createdAt DateTime         @default(now())

  @@index([offerId, status])
}

model OnlineCodeSale {
  id                String           @id @default(cuid())
  offerId           String
  offer             OnlineOffer      @relation(fields: [offerId], references: [id])
  codeId            String           @unique
  code              OnlineAccessCode @relation(fields: [codeId], references: [id])
  studentId         String?
  student           Student?         @relation(fields: [studentId], references: [id])
  buyerPhone        String?
  buyerName         String?
  amount            Decimal          @db.Decimal(12, 2)
  teacherShare      Decimal          @db.Decimal(12, 2)
  centerShare       Decimal          @db.Decimal(12, 2)
  method            SessionPayMethod
  vodafoneTxn       String?
  payStatus         SessionPayStatus @default(PENDING_CONFIRM)
  receiptNumber     String           @unique
  confirmedAt       DateTime?
  confirmedByUserId String?
  soldByUserId      String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([offerId, createdAt])
}

model HandoutProduct {
  id             String        @id @default(cuid())
  teacherId      String?
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])
  title          String
  price          Decimal       @db.Decimal(12, 2)
  teacherPercent Decimal       @db.Decimal(5, 2)
  stock          Int           @default(0)
  isActive       Boolean       @default(true)
  sales          HandoutSale[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model HandoutSale {
  id                String           @id @default(cuid())
  productId         String
  product           HandoutProduct   @relation(fields: [productId], references: [id])
  studentId         String?
  student           Student?         @relation(fields: [studentId], references: [id])
  sessionId         String?
  session           ClassSession?    @relation(fields: [sessionId], references: [id])
  qty               Int              @default(1)
  unitPrice         Decimal          @db.Decimal(12, 2)
  amount            Decimal          @db.Decimal(12, 2)
  teacherShare      Decimal          @db.Decimal(12, 2)
  centerShare       Decimal          @db.Decimal(12, 2)
  method            SessionPayMethod
  vodafoneTxn       String?
  payStatus         SessionPayStatus @default(PENDING_CONFIRM)
  receiptNumber     String           @unique
  confirmedAt       DateTime?
  confirmedByUserId String?
  soldByUserId      String?
  buyerPhone        String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productId, createdAt])
}

model RoomRental {
  id                String           @id @default(cuid())
  classroomId       String
  classroom         Classroom        @relation(fields: [classroomId], references: [id])
  renterName        String
  renterPhone       String?
  title             String?
  startsAt          DateTime
  endsAt            DateTime
  amount            Decimal          @db.Decimal(12, 2)
  method            SessionPayMethod @default(CASH)
  vodafoneTxn       String?
  payStatus         SessionPayStatus @default(PENDING_CONFIRM)
  status            RentalStatus     @default(BOOKED)
  receiptNumber     String?          @unique
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdByUserId   String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([classroomId, startsAt])
  @@index([status, startsAt])
}
